{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start LedgerLine Backend (Spring Boot)",
            "type": "shell",
            "command": "mvn spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}/Backend/backend/ledgerline"
            },
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Start LedgerLine Frontend (Vite Dev Server)",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": "build"
        }
    ]
}


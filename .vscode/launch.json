{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "LedgerLine Backend (Spring Boot)",
            "request": "launch",
            "mainClass": "com.ledgerline.LedgerLineApplication",
            "projectName": "ledgerline",
            "cwd": "${workspaceFolder}/Backend/backend/ledgerline",
            "env": {
                "DB_PASSWORD": "postgres",
                "SERVER_PORT": "8080"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "LedgerLine Frontend (Browser)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src"
        }
    ]
}

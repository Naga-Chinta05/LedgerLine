{
  "info": {
    "name": "LedgerLine – Banking & Double-Entry Ledger API",
    "description": "Comprehensive Postman collection for the LedgerLine Digital Banking & Transaction Ledger System (Snovasys Fresher Hiring Challenge 2026). Includes automated token extraction, idempotency testing, and role-based test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Customer (John Doe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    console.log('Saved Customer JWT Token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    console.log('Saved Admin JWT Token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ledgerline.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Compliance Auditor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    console.log('Saved Auditor JWT Token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"auditor@ledgerline.com\",\n  \"password\": \"Auditor@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register New Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Robert King\",\n  \"email\": \"robert.king@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ACCOUNT_HOLDER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Get Authenticated Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Bank Accounts",
      "item": [
        {
          "name": "Get My Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Create New Checking Account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"INR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          }
        },
        {
          "name": "Lookup Account by Number",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/accounts/number/LL-1001001001", "host": ["{{baseUrl}}"], "path": ["accounts", "number", "LL-1001001001"] }
          }
        },
        {
          "name": "Admin: List All System Accounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/accounts?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["admin", "accounts"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "10"}] }
          }
        },
        {
          "name": "Admin: Freeze Account Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FROZEN\",\n  \"reason\": \"Suspicious transaction pattern under investigation\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/accounts/1/status", "host": ["{{baseUrl}}"], "path": ["accounts", "1", "status"] }
          }
        }
      ]
    },
    {
      "name": "3. Transactions & Money Movement",
      "item": [
        {
          "name": "Deposit Funds (Double-Entry Debit Reserve, Credit Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "dep-postman-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"LL-1001001001\",\n  \"amount\": 5000.00,\n  \"description\": \"Savings deposit\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions/deposit", "host": ["{{baseUrl}}"], "path": ["transactions", "deposit"] }
          }
        },
        {
          "name": "Withdraw Funds (Pessimistic Lock & Balance Check)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "wdr-postman-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"LL-1001001001\",\n  \"amount\": 1500.00,\n  \"description\": \"ATM cash withdrawal\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions/withdraw", "host": ["{{baseUrl}}"], "path": ["transactions", "withdraw"] }
          }
        },
        {
          "name": "Transfer Funds (Deadlock-Free Ascending Lock Ordering)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "xfer-postman-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"LL-1001001001\",\n  \"destinationAccountNumber\": \"LL-2002002002\",\n  \"amount\": 2500.00,\n  \"description\": \"Consulting fee settlement\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions/transfer", "host": ["{{baseUrl}}"], "path": ["transactions", "transfer"] }
          }
        },
        {
          "name": "Idempotency Replay Test (Re-send identical transfer key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "xfer-postman-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"LL-1001001001\",\n  \"destinationAccountNumber\": \"LL-2002002002\",\n  \"amount\": 2500.00,\n  \"description\": \"Consulting fee settlement\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transactions/transfer", "host": ["{{baseUrl}}"], "path": ["transactions", "transfer"] }
          }
        },
        {
          "name": "Get My Transaction History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/transactions?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["transactions"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "10"}] }
          }
        }
      ]
    },
    {
      "name": "4. Compliance & Double-Entry Ledger Audit",
      "item": [
        {
          "name": "Get Balanced Ledger Lines for Transaction",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/ledger/transaction/1", "host": ["{{baseUrl}}"], "path": ["ledger", "transaction", "1"] }
          }
        },
        {
          "name": "Auditor: Zero-Sum Reconciliation Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/ledger/reconciliation", "host": ["{{baseUrl}}"], "path": ["ledger", "reconciliation"] }
          }
        },
        {
          "name": "Auditor: Immutable Audit Trail Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/audit/logs?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["audit", "logs"], "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}] }
          }
        }
      ]
    }
  ]
}
